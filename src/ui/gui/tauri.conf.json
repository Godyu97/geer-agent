{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "geer-agent",
  "version": "0.1.0",
  "identifier": "dev.geer.agent",
  "build": {
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "geer-agent",
        "width": 1160,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
