OPENAI_API_KEY= ""
OPENAI_MODEL= ""
OPENAI_BASE_URL= "https://api.openai.com/v1"
# 可选：默认 responses；仅兼容旧接口的服务改为 chat-completions
OPENAI_API= "responses"
# 界面选择：auto 为终端 TUI / 管道 REPL；gui 需构建时启用 Cargo gui feature
# GEER_AGENT_UI= "auto"
# 可选：默认 on；设为 off 时不声明也不执行工具，仍可普通聊天
GEER_AGENT_TOOLS= "on"
# 可选：Bash 可执行文件的绝对路径。留空时 Windows 优先 C:\Program Files\Git\bin\bash.exe，找不到再用 PATH 中的 bash；Linux 使用 PATH 中的 bash
GEER_AGENT_BASH_BIN= ""
# 可选：单条输入最长执行秒数，默认 600
# GEER_AGENT_MAX_DURATION_SECONDS=600
# 可选：接口报告的累计 Token 上限
# GEER_AGENT_MAX_INPUT_TOKENS=100000
# GEER_AGENT_MAX_OUTPUT_TOKENS=10000
# 可选：费用上限；启用时必须同时配置下方两个单价
# GEER_AGENT_MAX_COST_USD=1.00
# GEER_AGENT_INPUT_USD_PER_MILLION_TOKENS=1.00
# GEER_AGENT_OUTPUT_USD_PER_MILLION_TOKENS=4.00

# 默认：会话和 Trace 共用选定 .env 目录的 .db/geer.sqlite；cargo run 可选项目根目录
# GEER_AGENT_DATABASE=sqlite
# 可选：显式 URL 会覆盖同目录默认路径；例如指定已有数据库的绝对路径
# GEER_AGENT_DATABASE_URL=sqlite:///absolute/path/to/geer.sqlite?mode=rwc
# 可分别关闭；关闭会话持久化后仍可在进程内切换会话
# GEER_AGENT_TRACE=on
# GEER_AGENT_SESSION_PERSISTENCE=on
# 可选：上下文窗口与自动压缩；/compact 始终可手动触发
# GEER_AGENT_CONTEXT_WINDOW_TOKENS=272000
# GEER_AGENT_AUTO_COMPACT=on
