{
  "version": 1,
  "source_roots": [
    "Cargo.toml",
    "Cargo.lock",
    "Makefile",
    ".gitignore",
    ".env.example",
    "build.rs",
    "src",
    "scripts",
    "tests",
    ".agents",
    "openspec/config.yaml"
  ],
  "excluded_paths": [
    {
      "path": "src/ui/frontend/node_modules",
      "reason": "Bun 根据 package.json/bun.lock 安装的第三方依赖；不是第一方源码，可在未安装的 checkout 中缺失。"
    },
    {
      "path": "src/ui/frontend/dist",
      "reason": "Vite 根据共用前端源码生成的 GUI/Web 静态产物；维护源是 src/ui/frontend/src 与构建配置，可在未构建的 checkout 中缺失。"
    }
  ],
  "components": [
    {
      "root": ".",
      "language": "Rust 2024",
      "role": "单一二进制应用",
      "manifest": "Cargo.toml",
      "notes": "非 Cargo workspace；终端界面是默认构建，gui/web 通过可选 features 启用。"
    },
    {
      "root": "src/ui/frontend",
      "language": "TypeScript / React",
      "role": "GUI 与 Web 共用前端包",
      "manifest": "src/ui/frontend/package.json",
      "notes": "React、Vite、TypeScript、Vitest；Bun 1.4.2 管理依赖，通过 desktop/web HostAdapter 对接宿主。"
    },
    {
      "root": ".",
      "language": "POSIX Shell / Python / Rust",
      "role": "开发命令、测试隔离与进程夹具",
      "manifest": "Makefile",
      "notes": "scripts/test-safe.sh 使用 systemd/cgroup v2；scripts/test-safe-check.py 和 tests/support/mod.rs 提供有界安全验证与夹具。"
    },
    {
      "root": ".agents",
      "language": "Markdown / Python",
      "role": "已安装仓库工作流",
      "manifest": ".agents/skills/.openspec-target",
      "notes": "OpenSpec skill 由 CLI 刷新；Git runner 随对应 skill 安装，归属登记不授予运行或修改权限。"
    }
  ],
  "modules": [
    {
      "id": "dev-tooling",
